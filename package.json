{
  "name": "speed-sheet",
  "private": true,
  "version": "0.1.0",
  "description": "Headless spreadsheet engine — modern rewrite of Luckysheet",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "typecheck": "turbo run typecheck",
    "demo": "pnpm --filter @speed-sheet/demo dev"
  },
  "devDependencies": {
    "@ant-design/icons-vue": "^7.0.0",
    "@types/node": "^22.0.0",
    "ant-design-vue": "^4.2.0",
    "tsup": "^8.5.1",
    "turbo": "^2.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "vue": "^3.5.0"
  },
  "peerDependencies": {
    "yjs": "^13.6.0"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@9.0.0"
}
