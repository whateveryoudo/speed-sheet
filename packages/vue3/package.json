{
  "name": "@speed-sheet/vue3",
  "version": "0.1.0",
  "type": "module",
  "description": "Headless Vue 3 bindings (SheetRenderer + useSheet), no UI library",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "dev": "vite build --watch",
    "typecheck": "vue-tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@speed-sheet/core": "workspace:^",
    "@speed-sheet/extension-formula": "workspace:^",
    "@speed-sheet/shared": "workspace:^",
    "yjs": "^13.6.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vue": "^3.5.0",
    "vue-tsc": "^2.0.0"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  }
}
