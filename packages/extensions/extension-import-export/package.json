{
  "name": "@speed-sheet/extension-import-export",
  "version": "0.1.1",
  "type": "module",
  "description": "Headless import/export conversion engine for speed-sheet (XLSX, SpeedSheet, CSV)",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@speed-sheet/core": "workspace:^",
    "@speed-sheet/shared": "workspace:^",
    "exceljs": "^4.4.0"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "yjs": "^13.6.0"
  },
  "peerDependencies": {
    "yjs": "^13.6.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
