  },
  "dependencies": {
    "@speed-sheet/core": "workspace:^",
    "@speed-sheet/shared": "workspace:^",
    "echarts": "^6.1.0",
    "lodash-es": "^4.17.21"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.12",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
