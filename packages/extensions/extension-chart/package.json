{
  "name": "@speed-sheet/extension-chart",
  "version": "0.1.0",
  "type": "module",
  "description": "Floating chart extension and option builder for speed-sheet",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
