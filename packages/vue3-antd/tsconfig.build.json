{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": ".",
    "jsx": "preserve",
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": true,
    "paths": {
      "vue": ["node_modules/vue/dist/vue.d.ts"]
    },
    "plugins": [
      {
        "name": "@vue/typescript-plugin",
        "include": ["src/**/*.vue"]
      }
    ]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "src/env.d.ts"
  ],
  "exclude": ["src/**/__tests__/**"],
  "vueCompilerOptions": {
    "target": 3.5
  }
}
