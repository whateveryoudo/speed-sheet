{
  "name": "@speed-sheet/vue3-antd",
  "version": "0.1.0",
  "type": "module",
  "description": "Ant Design Vue toolbar for speed-sheet (optional UI layer)",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "dev": "vite build --watch",
    "typecheck": "vue-tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.6.0",
    "@speed-sheet/core": "workspace:^",
    "@speed-sheet/extension-filter": "workspace:^",
    "@speed-sheet/extension-formula": "workspace:^",
    "@speed-sheet/extension-image": "workspace:^",
    "@speed-sheet/shared": "workspace:^",
    "@speed-sheet/vue3": "workspace:^",
    "speed-components-ui": "^1.1.3",
    "viewerjs": "^1.11.7",
    "vue-i18n": "^10.0.0",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@ant-design/icons-vue": "^7.0.0",
    "@unocss/vite": "^0.58.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vitejs/plugin-vue-jsx": "^5.1.1",
    "@vue/typescript-plugin": "^2.2.0",
    "ant-design-vue": "^4.2.0",
    "less": "^4.2.0",
    "typescript": "^5.6.0",
    "unocss": "^0.58.0",
    "unplugin-vue-components": "^28.7.0",
    "vite": "^6.0.0",
    "vue": "^3.5.0",
    "vue-tsc": "^2.0.0"
  },
  "peerDependencies": {
    "@ant-design/icons-vue": "^7.0.0",
    "@speed-sheet/core": "workspace:*",
    "@speed-sheet/extension-filter": "workspace:*",
    "@speed-sheet/extension-formula": "workspace:*",
    "@speed-sheet/extension-image": "workspace:*",
    "@speed-sheet/shared": "workspace:*",
    "@speed-sheet/vue3": "workspace:*",
    "ant-design-vue": "^4.0.0",
    "speed-components-ui": ">=1.1.3",
    "vue": "^3.3.0",
    "vue-i18n": "^10.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
