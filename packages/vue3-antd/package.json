{
  "name": "@speed-sheet/vue3-antd",
  "version": "0.1.0",
  "type": "module",
  "description": "Ant Design Vue toolbar for speed-sheet (optional UI layer)",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "vue-tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@speed-sheet/core": "workspace:^",
    "@speed-sheet/shared": "workspace:^",
    "@speed-sheet/vue3": "workspace:^"
  },
  "devDependencies": {
    "@ant-design/icons-vue": "^7.0.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "ant-design-vue": "^4.2.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vue": "^3.5.0",
    "vue-tsc": "^2.0.0"
  },
  "peerDependencies": {
    "ant-design-vue": "^4.2.0",
    "@ant-design/icons-vue": "^7.0.0",
    "vue": "^3.5.0"
  }
}
